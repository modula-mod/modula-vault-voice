      "server"
    ]
  },
  "lifecycle": {
    "executionMode": "declarative",
    "defaultState": "installed",
    "allowedTransitions": [
      {
        "from": "discovered",
        "to": "installed",
        "auditEvent": "module.installed"
      },
      {
        "from": "installed",
        "to": "enabled",
        "requiresConfirmation": true,
        "auditEvent": "module.enabled"
      },
      {
        "from": "enabled",
        "to": "disabled",
        "auditEvent": "module.disabled"
      },
      {
        "from": "disabled",
        "to": "enabled",
        "requiresConfirmation": true,
        "auditEvent": "module.enabled"
      },
      {
        "from": "enabled",
        "to": "updating",
        "auditEvent": "module.update-started"
      },
      {
        "from": "updating",
        "to": "enabled",
        "auditEvent": "module.updated"
      },
      {
        "from": "updating",
        "to": "failed",
        "auditEvent": "module.update-failed"
      },
      {
        "from": "enabled",
        "to": "quarantined",
        "auditEvent": "module.quarantined"
      },
      {
        "from": "failed",
        "to": "disabled",
        "auditEvent": "module.disabled"
      },
      {
        "from": "disabled",
        "to": "uninstalled",
        "requiresConfirmation": true,
        "auditEvent": "module.uninstalled"
      }
    ],
    "uninstall": {
      "dataPolicy": "retain",
      "requiresConfirmation": true
    }
  },
  "permissions": [
    {
      "id": "notes.attachments.read",
      "reason": "Read only the recording selected for playback or transcription.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.attachments.create",
      "reason": "Attach a user-created recording to the selected note.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.update",
      "reason": "Insert a user-approved transcript into the selected note.",
      "risk": "medium",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.editor.contribute",
      "reason": "Register declared recording and transcript commands.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "notes.actions.contribute",
      "reason": "Register declared note actions.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "media.audio.capture",
      "reason": "Capture audio only after an explicit user action.",
      "risk": "high",
      "required": true,
      "policyMode": "require-confirmation"
    },
    {
      "id": "media.audio.playback",
      "reason": "Play a selected Vault Voice recording.",
      "risk": "low",
      "required": true,
      "policyMode": "observe"
    },
    {
      "id": "transcription.request",
      "reason": "Submit an explicitly selected recording to an approved provider.",
      "risk": "high",
      "required": true,
      "policyMode": "require-confirmation"
    }
  ],
  "capabilities": [
    {
      "id": "files",
      "required": true,
      "reason": "Capture, attach, and play user-controlled audio through host platform adapters."
    },
    {
      "id": "offline",
      "required": true,
      "reason": "Save recordings locally before optional transcription."
    },
    {
      "id": "functions",
      "required": true,
      "reason": "Expose declared Vault Voice actions."
    },
    {
      "id": "services",
      "required": true,
      "reason": "Invoke a configured transcription provider through Greenfield."
    },
    {
      "id": "ui-contributions",
      "required": true,
      "reason": "Publish declarative recording and attachment actions."
    },
    {
      "id": "jobs",
      "required": true,
      "reason": "Run bounded transcription jobs."
    }
  ],
