{
  "id": "settings",
  "kind": "settings",
  "title": "Vault Voice settings",
  "bindings": [
    {"id": "preferences", "source": "settings", "settingsKey": "vaultVoice.preferences"},
    {"id": "transcriptionProvider", "source": "capability", "capability": "voice.transcribe"},
    {"id": "audioCapture", "source": "capability", "capability": "audio.capture@1"}
  ],
  "root": {
    "type": "section",
    "accessibility": {"label": "Vault Voice settings", "role": "form"},
    "children": [
      {"type": "text", "text": "Microphone access is requested only after you choose Record. The host controls the native permission prompt and audio capture."},
      {"type": "metadata", "text": "Microphone capability", "binding": "audioCapture"},
      {"type": "metadata", "text": "Transcription provider status", "binding": "transcriptionProvider"},
      {"type": "field", "binding": "preferences", "field": {"id": "autoOfferTranscription", "type": "boolean", "label": "Offer transcription after recording"}},
      {"type": "field", "binding": "preferences", "field": {"id": "keepOriginalAudio", "type": "boolean", "label": "Keep original audio after transcription"}},
      {"type": "button", "text": "Save Voice preferences", "action": "saveVoiceSettings"}
    ]
  },
  "states": {
    "capabilityUnavailable": {"type": "errorState", "text": "No transcription provider is configured. Recordings remain available, and Vault Voice will not fabricate a transcript.", "accessibility": {"role": "status"}},
    "permissionDenied": {"type": "errorState", "text": "Microphone permission is required only to record new audio. Existing recordings remain available.", "accessibility": {"role": "status"}},
    "error": {"type": "errorState", "text": "Vault Voice settings are unavailable", "accessibility": {"role": "status"}}
  }
}
