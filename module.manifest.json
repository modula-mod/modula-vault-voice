      "greenfield.v1"
    ],
    "platforms": [
      "ios",
      "android",
      "web",
      "server"
    ],
    "nativeCapabilities": [
      "microphone",
      "audio-playback"
    ]
  },
  "permissions": [
    {
      "permission": "notes.attachments.read",
      "reason": "Read only the recording selected for playback or transcription.",
      "risk": "low"
    },
    {
      "permission": "notes.attachments.create",
      "reason": "Attach a user-created recording to the selected note.",
      "risk": "medium"
    },
    {
      "permission": "notes.update",
      "reason": "Insert a user-approved transcript into the selected note.",
      "risk": "medium"
    },
    {
      "permission": "notes.editor.contribute",
      "reason": "Register declared recording and transcript commands.",
      "risk": "low"
    },
    {
      "permission": "notes.actions.contribute",
      "reason": "Register declared note actions.",
      "risk": "low"
    },
    {
      "permission": "media.audio.capture",
      "reason": "Capture audio only after an explicit user action.",
      "risk": "high"
    },
    {
      "permission": "media.audio.playback",
      "reason": "Play a selected Vault Voice recording.",
      "risk": "low"
    },
    {
      "permission": "transcription.request",
      "reason": "Submit an explicitly selected recording to an approved provider.",
      "risk": "high"
    }
  ],
  "dependencies": [
    {
      "moduleId": "digital.modula.vault-notes",
      "versionRange": ">=1.2.0 <2.0.0",
      "optional": false,
      "reason": "Vault Voice extends Vault Notes."
    }
  ],
  "contributions": {
    "functions": [
      {
        "id": "digital.modula.vault-notes.voice.function.record.registration",
        "title": "Record audio",
        "functionId": "digital.modula.vault-notes.voice.function.record",
        "mode": "hostNative",
        "inputSchemaRef": "schemas/vault-voice-request.schema.json",
        "outputSchemaRef": "schemas/vault-voice-result.schema.json",
        "executionRequired": true
      },
      {
        "id": "digital.modula.vault-notes.voice.function.play.registration",
        "title": "Play recording",
        "functionId": "digital.modula.vault-notes.voice.function.play",
        "mode": "hostNative",
        "inputSchemaRef": "schemas/vault-voice-request.schema.json",
        "outputSchemaRef": "schemas/vault-voice-result.schema.json",
        "executionRequired": true
      },
      {
        "id": "digital.modula.vault-notes.voice.function.transcribe.registration",
        "title": "Transcribe recording",
        "functionId": "digital.modula.vault-notes.voice.function.transcribe",
        "mode": "remoteHttp",
        "inputSchemaRef": "schemas/vault-voice-request.schema.json",
        "outputSchemaRef": "schemas/vault-voice-result.schema.json",
        "executionRequired": true
      },
      {
        "id": "digital.modula.vault-notes.voice.function.insert-transcript.registration",
        "title": "Insert transcript into note",
        "functionId": "digital.modula.vault-notes.voice.function.insert-transcript",
        "mode": "remoteHttp",
        "inputSchemaRef": "schemas/vault-voice-request.schema.json",
        "outputSchemaRef": "schemas/vault-voice-result.schema.json",
        "executionRequired": true
      }
    ],
    "tools": [
      {
        "id": "digital.modula.vault-notes.voice.tool.record",
        "title": "Record Voice Note",
        "toolId": "digital.modula.vault-notes.voice.tool.record",
        "functionId": "digital.modula.vault-notes.voice.function.record",
        "surfaces": [
          "composer-tools",
          "vault-notes"
        ]
      }
    ],
    "jobs": [
      {
        "id": "digital.modula.vault-notes.voice.job.transcription",
        "title": "Vault Voice transcription",
        "jobType": "vault-voice.transcription.v1",
        "mode": "backgroundJob"
      }
    ]
  },
  "backend": {
    "mode": "module-managed",
    "protocolVersion": "1.0.0",
    "endpoints": {
      "baseUrlStrategy": "registry",
      "apiVersion": "1.0.0",
      "discoveryPath": "/.well-known/modula-module.json",
      "healthPath": "/v1/health",
      "capabilitiesPath": "/v1/capabilities",
      "actionsPath": "/v1/actions",
      "allowedHosts": [
        "vault-voice.modula.digital"
      ]
    },
    "authentication": {
      "strategy": "greenfield-signed-jwt",
      "tokenExchangeRequired": true,
      "audience": "modula-vault-voice",
      "tokenTtlSeconds": 120,
      "sessionExchangePath": "/v1/session/exchange"
    },
    "trust": {
      "publisherId": "modula",
      "allowedOrigins": [
        "https://vault-voice.modula.digital"
      ]
    },
    "data": {
      "primaryStore": "module-backend",
      "categories": [
        {
          "id": "vault-voice-recordings",
          "description": "Extension-owned recording metadata, transcription jobs, and transcripts.",
          "location": "module-backend",
          "classification": "restricted",
          "exportable": true,
          "deletable": true
        }
      ],
      "exportSupported": true,
      "deletionSupported": true,
      "backupResponsibility": "publisher"
    },
    "deployment": {
      "ownership": "modula-hosted",
      "multiTenant": true,
      "selfHostingSupported": false
    },
    "actions": [
      {
        "actionId": "digital.modula.vault-notes.voice.function.transcribe",
        "title": "transcribe",
        "method": "POST",
        "path": "/v1/actions/transcribe",
        "inputSchema": "schemas/transcription-request.schema.json",
        "outputSchema": "schemas/transcription-result.schema.json",
        "permissions": [
          "notes.attachments.read",
          "transcription.request"
        ],
        "idempotent": true,
        "timeoutMs": 30000,
        "sideEffects": "internal-write",
        "confirmation": "user"
      }
    ]
  },
  "integrity": {
    "manifestSha256": "ac54fe809cb2f393b3bbb7c20149062d050e7e22afac25f0f7ea47454763d4e8",
